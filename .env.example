# Firebase Configuration Template
# In Expo SDK 49+, environment variables starting with EXPO_PUBLIC_ are automatically accessible in client code.
# Copy this file to .env and replace with your actual Firebase Project keys from Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> Config

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
