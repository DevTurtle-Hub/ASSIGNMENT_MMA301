rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection: Authenticated users can read profiles; users can write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Teams Collection: Authenticated users can read and create teams
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();

      // Real-time Chat Messages Subcollection: teams/{teamId}/messages/{messageId}
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Team Members Collection: Authenticated users can read and join teams
    match /teamMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Tasks Collection: Authenticated users can read, create, update, and delete tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
  }
}
